# Razorpay — get these from https://dashboard.razorpay.com/app/keys
# Use rzp_test_... keys while developing, rzp_live_... in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# NOTE: RAZORPAY_KEY_ID is also returned to the browser by
# /api/payment/create-order (Razorpay's key id is meant to be public —
# only the key SECRET must stay server-side, which is why only
# RAZORPAY_KEY_SECRET is read in lib/razorpay.js and never sent to the client).
